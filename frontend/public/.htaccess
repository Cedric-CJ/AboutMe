# Enable HTML5 history mode by redirecting all non-file requests to index.html
ErrorDocument 404 /index.html
<IfModule mod_rewrite.c>
  Options -MultiViews
  DirectoryIndex index.html

  RewriteEngine On
  RewriteBase /

  # Allow existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do not interfere with WordPress or PHP endpoints if present on the same host
  RewriteCond %{REQUEST_URI} ^/(wp-admin|wp-includes|wp-content|wp-login\.php|wp-).*$ [NC,OR]
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteRule ^ - [L]

  # Rewrite everything else to index.html (SPA fallback)
  RewriteRule . /index.html [L]
</IfModule>

# Additional fallback for servers supporting FallbackResource
FallbackResource /index.html
